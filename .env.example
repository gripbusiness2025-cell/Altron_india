# Production site origin (canonical URLs, Open Graph, sitemap). No trailing slash.
VITE_SITE_URL=https://altronindia.com

# Set to the public URL of your API in production, e.g. https://api.altronindia.com/api
# Leave unset in dev — Vite proxies /api → localhost:3001
# VITE_API_URL=https://api.example.com/api

# Use MongoDB catalog + products when API is up (default). Set to "static" to skip.
# VITE_CATALOG_SOURCE=mongodb
